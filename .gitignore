.DS_Store
__pycache__/
.venv/

# local secrets — ./serve.sh loads this; never commit it
.env


# the design canvas is assembled from the .dc.html sources next to it; the built
# page is 2.5MB of editor payload and lives online, so it is not worth committing
design/looper/middleman-looper.html

# the LAN development certificate: made on demand by ./phone.sh, never shared
certs/

# worktrees for design experiments (see EnterWorktree / ./.claude/worktrees), and
# whatever else an agent session leaves here -- except the skills, which are part of
# the repo: they are how an agent is told how this project does a job
.claude/*
!.claude/skills/

# the published site, assembled by scripts/site.sh for Netlify; never committed
dist/
