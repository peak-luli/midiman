# Local secrets for ./serve.sh and ./phone.sh. Copy to .env (gitignored) and fill in.
# Already-exported non-empty shell variables win; this file only fills gaps.
# A blank KEY= here does not block a later real value in .env or the shell.
# Never commit .env.

# Required for Feedback notes to reach GitHub (Issues: read and write on the repo).
MIDIMAN_GITHUB_TOKEN=

# Optional — defaults are fine for peak-luli/midiman. Uncomment to override.
# MIDIMAN_FEEDBACK_REPO=peak-luli/midiman
# MIDIMAN_FEEDBACK_ISSUE=10
# MIDIMAN_FEEDBACK_LABEL=feedback
